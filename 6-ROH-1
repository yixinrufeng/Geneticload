#2参考基因组为非染色体级别
#!/bin/bash
# 提取长度 ≥100 kb 的 scaffold，并从 VCF 中保留这些 scaffold 上的变异位点
set -euo pipefail

# 直接用bcftools重新压缩为BGZF格式
bcftools view SRR9853731.DP_PL_filtered.vcf.gz -Oz -o SRR9853731.DP_PL_filtered_new.vcf.gz

# 替换原文件
mv SRR9853731.DP_PL_filtered_new.vcf.gz SRR9853731.DP_PL_filtered.vcf.gz

# 建立索引
bcftools index SRR9853731.DP_PL_filtered.vcf.gz

# 输入文件
REF=/raid6/bird/hp/ljr/Aquila_chrysaetos/01reference/auto.fna
VCF=SRR9853731.DP_PL_filtered.vcf.gz

# 输出前缀
OUT=SRR9853731.scaffold_ge100kb

# 1. 如果参考基因组没有 fai 索引，先建立
if [ ! -f ${REF}.fai ]; then
    samtools faidx ${REF}
fi

# 2. 提取长度 >= 100 kb 的 scaffold 名称
awk '$2 >= 100000 {print $1}' ${REF}.fai > scaffold_ge100kb.list

# 3. 生成 bcftools 可识别的 region 文件
# 格式：scaffold start end
awk '$2 >= 100000 {print $1"\t1\t"$2}' ${REF}.fai > scaffold_ge100kb.regions

# 4. 确保 VCF 有索引
# 建议用 CSI 索引，更适合非模式物种和较长 scaffold
if [ ! -f ${VCF}.csi ] && [ ! -f ${VCF}.tbi ]; then
    bcftools index -f ${VCF}
fi

# 5. 从 VCF 中提取这些 scaffold 上的位点
bcftools view \
    -R scaffold_ge100kb.regions \
    -Oz \
    -o ${OUT}.vcf.gz \
    ${VCF}

# 6. 建立新 VCF 索引
bcftools index -f ${OUT}.vcf.gz

# 7. 简单统计
echo "Number of scaffolds >=100 kb:"
wc -l scaffold_ge100kb.list

echo "Number of variants retained:"
bcftools view -H ${OUT}.vcf.gz | wc -l

# 8. VCF to PLINK format
plink \
  --vcf ${OUT}.vcf.gz \
  --double-id \
  --allow-extra-chr \
  --make-bed \
  --out ${OUT}

# 9. ROH detection
plink \
  --bfile ${OUT} \
  --homozyg \
  --homozyg-window-snp 80 \
  --homozyg-snp 150 \
  --homozyg-density 50 \
  --homozyg-kb 10 \
  --allow-extra-chr \
  --out SRR9853731.roh
