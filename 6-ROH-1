#Alignment_and_variant_calling&VCF_Filtration
#!/bin/bash
set -euo pipefail
#对bam文件建立索引
samtools index /raid6/bird/hp/ljr/Aquila_chrysaetos/02data/SRR26919696.bam
REF=/raid6/bird/hp/ljr/Aquila_chrysaetos/01reference/auto.fna
BAM=/raid6/bird/hp/ljr/Aquila_chrysaetos/02data/SRR26919696.bam
SAMPLE=SRR26919696

# 0. Prepare reference index
if [ ! -f ${REF}.fai ]; then
    samtools faidx ${REF}
fi

if [ ! -f ${REF%.fna}.dict ]; then
    gatk CreateSequenceDictionary \
      -R ${REF} \
      -O ${REF%.fna}.dict
fi

# 1. HaplotypeCaller
gatk --java-options "-Xmx30g" HaplotypeCaller \
  -R ${REF} \
  -I ${BAM} \
  -O ${SAMPLE}.g.vcf.gz \
  -ERC GVCF \
  --native-pair-hmm-threads 8

# 2. GenotypeGVCFs
# 单样本可以直接 GenotypeGVCFs，不需要 CombineGVCFs
gatk --java-options "-Xmx30g" GenotypeGVCFs \
  -R ${REF} \
  -V ${SAMPLE}.g.vcf.gz \
  -O ${SAMPLE}.raw.vcf.gz

# 3. Select SNPs
gatk --java-options "-Xmx15g" SelectVariants \
  -R ${REF} \
  -V ${SAMPLE}.raw.vcf.gz \
  --select-type-to-include SNP \
  -O ${SAMPLE}.raw.snp.vcf.gz

# 4. Hard filtering
gatk --java-options "-Xmx50g" VariantFiltration \
  -R ${REF} \
  -V ${SAMPLE}.raw.snp.vcf.gz \
  --filter-expression "QUAL < 30.0 || QD < 2.0 || MQ < 40.0 || FS > 60.0 || SOR > 3.0 || MQRankSum < -12.5 || ReadPosRankSum < -8.0" \
  --filter-name "snp_filter" \
  -O ${SAMPLE}.SNP_hardfil.vcf.gz

# 5. Remove filtered sites
gatk --java-options "-Xmx15g" SelectVariants \
  -R ${REF} \
  -V ${SAMPLE}.SNP_hardfil.vcf.gz \
  --exclude-filtered true \
  -O ${SAMPLE}.SNP_hardfil_true.vcf.gz

# 6. Keep biallelic SNPs only
bcftools view \
  -m2 -M2 -v snps \
  ${SAMPLE}.SNP_hardfil_true.vcf.gz \
  -Oz \
  -o ${SAMPLE}.SNP_hardfil_true.biallelic.snp.vcf.gz

bcftools index -f ${SAMPLE}.SNP_hardfil_true.biallelic.snp.vcf.gz

# 7. Depth filtering
vcftools \
  --gzvcf ${SAMPLE}.SNP_hardfil_true.biallelic.snp.vcf.gz \
  --minDP 8 \
  --maxDP 46 \
  --max-missing 1.0 \
  --recode \
  --recode-INFO-all \
  --out ${SAMPLE}_DPfiltered

# 8. Compress and index
bcftools view \
  -v snps \
  ${SAMPLE}_DPfiltered.recode.vcf \
  -Oz \
  -o ${SAMPLE}_DPfiltered_SNPs.vcf.gz

bcftools index -f ${SAMPLE}_DPfiltered_SNPs.vcf.gz

# 9. PL value filtering
perl /raid6/bird/hp/ljr/filter_PLvalue.pl \
  ${SAMPLE}_DPfiltered_SNPs.vcf.gz \
  ${SAMPLE}.DP_PL_filtered.vcf.gz \
  0.2 20 1

