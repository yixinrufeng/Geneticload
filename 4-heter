#!/bin/bash
set -euo pipefail

########################################
# 需要修改的变量
########################################

SPECIES="Ammospiza_maritima"
SAMPLE="SRR9946437"

REF_DIR="/path/${SPECIES}/01reference"
WORK_DIR="/path/${SPECIES}/02resequencing/${SAMPLE}"

REF_FA="${REF_DIR}/auto.fna"

THREADS=6

########################################
# 进入工作目录
########################################

cd "${WORK_DIR}"

########################################
# 检查输入文件
########################################

if [[ ! -s "${SAMPLE}.bam" ]]; then
    echo "ERROR: BAM file not found: ${SAMPLE}.bam"
    exit 1
fi

if [[ ! -s "${SAMPLE}.bam.bai" ]]; then
    echo "ERROR: BAM index not found: ${SAMPLE}.bam.bai"
    exit 1
fi

if [[ ! -s "${REF_FA}" ]]; then
    echo "ERROR: Reference FASTA not found: ${REF_FA}"
    exit 1
fi

########################################
# ANGSD 计算 SAF
########################################

echo "Running ANGSD..."

angsd \
    -i "${SAMPLE}.bam" \
    -anc "${REF_FA}" \
    -ref "${REF_FA}" \
    -out "${SAMPLE}" \
    -dosaf 1 \
    -GL 2 \
    -C 50 \
    -minQ 20 \
    -minMapQ 30 \
    -remove_bads 1 \
    -only_proper_pairs 1 \
    -uniqueOnly 1 \
    -P "${THREADS}"

########################################
########################################

echo "Running realSFS..."

realSFS "${SAMPLE}.saf.idx" -fold 1 -P "${THREADS}" > "${SAMPLE}.folded.ml"

echo "Done."
